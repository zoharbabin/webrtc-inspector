{
  "name": "@zoharbabin/webrtc-inspector",
  "version": "1.5.0",
  "description": "Framework-agnostic live WebRTC inspection and fault injection: peer connections, tracks, data channels, WebSockets, fake mic/camera, and real transport/signaling fault injection for reconnect testing.",
  "main": "extension/core/webrtc-inspector.js",
  "bin": {
    "webrtc-inspector-mcp": "mcp/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "extension",
    "mcp",
    "test",
    ".claude",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "webrtc",
    "devtools",
    "chrome-extension",
    "testing",
    "debugging",
    "instrumentation",
    "mcp"
  ],
  "author": "Zohar Babin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zoharbabin/webrtc-inspector.git"
  },
  "homepage": "https://github.com/zoharbabin/webrtc-inspector#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/zoharbabin/webrtc-inspector/issues"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:livekit": "playwright test --config=playwright.livekit.config.js",
    "report": "playwright show-report",
    "lint": "eslint .",
    "pack-extension": "node scripts/pack-extension.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.38.0",
    "js-yaml": "^4.3.1",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.62.1",
    "zod": "^3.25.76"
  }
}
